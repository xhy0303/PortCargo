+#if UNITY_6000_5_OR_NEWER
+        // wx-perf.dll unboxes Unity.GetObjectInstanceID as Int32 and only uses it
+        // as a profiling/deduplication key. Keep that ABI without truncating the
+        // 64-bit EntityId or using a hash (which can collide). These are SDK-local
+        // tokens, not Unity instance IDs, and must not be used for object lookup.
+        private static readonly Dictionary<EntityId, int> SdkObjectIds = new Dictionary<EntityId, int>();
+        private static int nextSdkObjectId;
+
+        private static int GetSdkObjectId(EntityId entityId)
+        {
+            if (!SdkObjectIds.TryGetValue(entityId, out var id))
+            {
+                id = checked(++nextSdkObjectId);
+                SdkObjectIds.Add(entityId, id);
+            }
+            return id;
+        }
+#endif
+
