<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net7.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <WeChatPlayer Condition="'$(WeChatPlayer)' == ''">true</WeChatPlayer>
    <DefineConstants Condition="'$(WeChatPlayer)' == 'true'">UNITY_WEBGL;PORT_WECHAT</DefineConstants>
    <DefineConstants Condition="'$(WeChatEditor)' == 'true'">$(DefineConstants);UNITY_EDITOR</DefineConstants>
    <DefineConstants Condition="'$(DevelopmentChecks)' == 'true'">$(DefineConstants);DEVELOPMENT_BUILD</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/PortCargo/Scripts/Core/NativeAdContract.cs" />
    <Compile Include="../../Assets/PortCargo/Scripts/Platform/WeChatNativeAds.cs" />
    <Compile Include="../../Assets/PortCargo/Scripts/Runtime/NativeAdsPresenter.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="PlatformStubs.cs" />
  </ItemGroup>
</Project>
